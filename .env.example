# Copy to .env.local for local work. In production these are set in Vercel → Settings → Environment Variables.
# Never commit real values.

# Cloudflare Turnstile. The values below are Cloudflare's public always-pass TEST keys.
# The site key is public by design; the secret key is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Supabase → Project Settings → API. The service-role (secret) key bypasses Row Level Security: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend. INQUIRY_FROM must use a domain verified in Resend.
RESEND_API_KEY=
INQUIRY_FROM=Ankur Worldwide Website <inquiries@ankurworldwide.com>
INQUIRY_TO=

# Any long random string. Used to hash visitor IPs for rate limiting. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=
